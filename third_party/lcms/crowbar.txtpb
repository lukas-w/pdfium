upstream {
  version: "lcms2.19.1"
  artifacts {
    git {
      repository: "https://github.com/mm2/Little-CMS"
      commit: "21c582a594fe5279f90c0b93437c398f93bf62b0"
    }
  }
}
stages {
  input {
    patch { copybara {} }
  }
  publish { git {} }
}
latest {
  generic {
    format: "lcms${n0}.${n1}${n2}"
    regex_groups { key: "n0" value: "[0-9]+" }
    regex_groups { key: "n1" value: "[0-9]+" }
    regex_groups { key: "n2" value: "(\\.[0-9]+)?" }
  }
  git {
    repository: "https://github.com/mm2/Little-CMS"
    tags {}
  }
}
