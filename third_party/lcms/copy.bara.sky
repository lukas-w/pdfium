        "src/cmsmtrx.c",
        "src/cmsnamed.c",
        "src/cmsopt.c",
        "src/cmspack.c",
        "src/cmspcs.c",
        "src/cmsplugin.c",
        "src/cmsps2.c",
        "src/cmssamp.c",
