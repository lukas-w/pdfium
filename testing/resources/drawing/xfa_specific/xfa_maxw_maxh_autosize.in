{{header}}
{{include ../../xfa_catalog_1_0.fragment}}
{{include ../../xfa_object_2_0.fragment}}
{{include ../../xfa_preamble_3_0.fragment}}
{{include ../../xfa_config_4_0.fragment}}
{{object 5 0}} <<
  {{streamlen}}
>>
stream
<template xmlns="http://www.xfa.org/schema/xfa-template/3.3/">
  <subform name="form1" layout="tb" locale="en_US" restoreState="auto">
    <pageSet>
      <pageArea name="Page1" id="Page1">
        <contentArea x="18pt" y="18pt" w="576pt" h="756pt"/>
        <medium stock="default" short="612pt" long="792pt"/>
      </pageArea>
    </pageSet>
    <!-- Auto-sizing subform with maxW="300pt" and maxH="200pt".
         Inner content is only 100pt x 50pt.
         Correct behavior: Container width auto-fits the 100pt content.
         Buggy behavior: Container width prematurely forced to maxW (300pt x 200pt). -->
    <subform name="autoContainer" layout="tb" maxW="300pt" maxH="200pt">
      <border>
        <edge stroke="solid" thickness="2pt">
          <color value="255,0,0"/>
        </edge>
      </border>
      <draw name="contentRect" w="100pt" h="50pt">
        <value>
          <rectangle>
            <edge stroke="solid" thickness="1pt">
              <color value="0,0,255"/>
            </edge>
            <fill>
              <color value="200,200,255"/>
            </fill>
          </rectangle>
        </value>
      </draw>
    </subform>
  </subform>
</template>
endstream
endobj
{{include ../../xfa_locale_6_0.fragment}}
