{{header}}
{{include ../../xfa_catalog_1_0.fragment}}
{{include ../../xfa_object_2_0.fragment}}
{{include ../../xfa_preamble_3_0.fragment}}
{{include ../../xfa_config_4_0.fragment}}
{{object 5 0}} <<
  {{streamlen}}
>>
stream
<template xmlns="http://www.xfa.org/schema/xfa-template/3.3/">
  <subform name="form1" layout="tb" locale="en_US" restoreState="auto">
    <pageSet>
      <pageArea name="Page1" id="Page1">
        <contentArea x="18pt" y="18pt" w="576pt" h="756pt"/>
        <medium stock="default" short="612pt" long="792pt"/>
      </pageArea>
    </pageSet>
    <!-- Section 1 resides on Page 1 (odd). -->
    <subform name="section1" w="576pt" h="200pt">
      <draw name="firstPageRect" w="200pt" h="100pt" x="50pt" y="50pt">
        <value>
          <rectangle>
            <edge stroke="solid" thickness="2pt">
              <color value="0,0,255"/>
            </edge>
            <fill>
              <color value="180,180,255"/>
            </fill>
          </rectangle>
        </value>
      </draw>
    </subform>
    <!-- Section 2 requests breakBefore to pageOdd.
         Correct behavior: Advances from Page 1 past Page 2 (blank filler) to Page 3 (odd).
         Buggy behavior: pageOdd break stub is a no-op; Section 2 renders immediately on Page 2. -->
    <subform name="section2" w="576pt" h="200pt">
      <breakBefore targetType="pageOdd"/>
      <draw name="thirdPageRect" w="200pt" h="100pt" x="50pt" y="50pt">
        <value>
          <rectangle>
            <edge stroke="solid" thickness="2pt">
              <color value="255,0,0"/>
            </edge>
            <fill>
              <color value="255,180,180"/>
            </fill>
          </rectangle>
        </value>
      </draw>
    </subform>
  </subform>
</template>
endstream
endobj
{{include ../../xfa_locale_6_0.fragment}}
{{include ../../xfa_postamble_7_0.fragment}}
{{include ../../xfa_pages_8_0.fragment}}
