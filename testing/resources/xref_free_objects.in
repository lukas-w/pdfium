{{header}}
% Omit object 1 to test a free entry immediately following object 0.
{{object 2 0}} <<
  /Type /Catalog
  /Pages 4 0 R
>>
endobj
% Omit object 3 to test a single free entry between in-use objects.
{{object 4 0}} <<
  /Type /Pages
  /Count 1
  /Kids [7 0 R]
>>
endobj
% Omit objects 5 and 6 to test consecutive free entries before the last
% in-use object.
{{object 7 0}} <<
  /Type /Page
  /Parent 4 0 R
  /MediaBox [0 0 200 200]
>>
endobj
{{xref}}
trailer <<
  /Root 2 0 R
  {{trailersize}}
>>
{{startxref}}
