%   $ pyftsubset NotoSansArabic-Regular.ttf \
%       --unicodes="U+0650,U+0652,U+FE91,U+FEB4,U+FEE2" \
%       --output-file=subset.ttf
%
% Step 2: Add a format 0 cmap mapping byte codes 1-5 to those glyphs for simple
